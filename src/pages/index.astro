-strip i{color:#c0a254;font-size:8px}.landing-section{padding:clamp(80px,10vw,130px) max(24px,calc((100vw - 1240px)/2))}.section-heading{display:flex;align-items:end;justify-content:space-between;gap:60px;margin-bottom:46px}.section-heading h2{margin:0;font-family:Fraunces,serif;font-size:clamp(42px,5vw,66px);font-weight:500;line-height:1;letter-spacing:-.04em}.section-heading>p{max-width:470px;margin:0;color:#61716a;font-size:15px;line-height:1.7}.collections{background:#f5f2e9}.collection-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.collection-card{position:relative;display:flex;min-height:440px;flex-direction:column;overflow:hidden;padding:22px;border:1px solid #cbcabe;border-radius:12px;background:#ebe7db;transition:.25s ease}.collection-card:hover{transform:translateY(-5px);box-shadow:0 18px 40px #21342c12}.card-number{position:relative;z-index:2;color:#66756f;font-size:10px;font-weight:800}.collection-art{position:absolute;inset:0 0 135px;overflow:hidden}.collection-art:before,.collection-art i{content:'';position:absolute;border-radius:50%}.collection-art:before{width:290px;height:290px;top:40px;left:calc(50% - 145px);border:1px solid #375d4d33}.collection-art i{width:210px;height:270px;top:80px;left:calc(50% - 105px);background:#7da283;clip-path:polygon(50% 0,76% 18%,89% 53%,75% 100%,45% 86%,9% 96%,17% 55%,0 27%)}.collection-art b{position:absolute;top:170px;left:50%;transform:translate(-50%,-50%);color:#f4e9c7;font-size:52px;font-weight:400}.ochre .collection-art i{background:#ad8952}.sky .collection-art i{background:#668e91}.card-copy{position:absolute;right:22px;bottom:22px;left:22px}.card-copy>*{display:block}.card-copy strong{font-family:Fraunces,serif;font-size:27px;font-weight:500}.card-copy small{min-height:54px;margin-top:7px;color:#64716b;font-size:12px;line-height:1.5}.card-copy span{margin-top:14px;color:#285e4c;font-size:11px;font-weight:800}.atlas-story{display:grid;grid-template-columns:.8fr 1.2fr;gap:clamp(70px,11vw,150px);