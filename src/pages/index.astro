---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { readFileSync } from 'node:fs';
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;

const loadGeoJSON = (name: string) => JSON.parse(readFileSync(`public/data/groups/${name}.geojson`, 'utf8'));
const parks = loadGeoJSON('parqe').features;
const protectedAreas = loadGeoJSON('mbrojtura').features;
const reserves = loadGeoJSON('rezervate').features;
const flora = loadGeoJSON('flora').features;
const fauna = loadGeoJSON('fauna').features;
const publishedNotes = JSON.parse(readFileSync('public/data/manual/notes.geojson', 'utf8')).features;
const areaTotal = parks.length + protectedAreas.length + reserves.length;
const observationTotal = flora.length + fauna.length;
const areaNames = ['Parku Kombëtar Divjakë-Karavasta', 'Parku Kombëtar Lugina e Valbonës', 'Parku Natyror Korab-Koritnik'];
const areaHighlights = areaNames.map((name) => [...parks, ...protectedAreas].find((item) => item.properties.name === name)).filter(Boolean);
const speciesHighlights = [flora[0], flora[1], fauna.find((item) => item.properties.name === 'Phoenicopterus roseus'), fauna.find((item) => item.properties.name === 'Fulica atra')].filter(Boolean);
---
<BaseLayout title="Trashëgimia Natyrore · Shqipëri dhe Kosovë" description="Një atlas i hapur i zonave të mbrojtura, florës dhe faunës në Shqipëri dhe Kosovë.">
  <SiteHeader page="home" />
  <main class="landing-page">
    <section class="heritage-hero">
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="hero-kicker"><span></span> Atlas i hapur · Shqipëri & Kosovë</p>
          <h1>Natyra që na është <em>lënë në kujdes.</em></h1>
          <p class="hero-lede">Një hartë e përbashkët për të zbuluar, dokumentuar dhe mbrojtur trashëgiminë natyrore shqiptare.</p>
          <div class="hero-actions">
            <a class="landing-button primary" href={`${base}map/`}>Eksploro hartën <span>→</span></a>
            <a class="landing-button secondary" href="#zonat">Shfleto të dhënat</a>
          </div>
          <p class="hero-note"><span aria-hidden="true">✦</span> Të dhëna të hapura, të ndërtuara së bashku</p>
        </div>

        <a class="map-preview" href={`${base}map/`} aria-label="Hap hartën interaktive">
          <div class="preview-top"><span>Harta e natyrës</span><span>AL · XK</span></div>
          <svg class="preview-map" viewBox="0 0 520 570" role="img" aria-label="Ilustrim i hartës së Shqipërisë dhe Kosovës">
            <defs><pattern id="grid" width="24" height="24" patternUnits="userSpaceOnUse"><path d="M24 0H0V24" fill="none" stroke="currentColor" stroke-opacity=".08"/></pattern></defs>
            <rect width="520" height="570" fill="url(#grid)"/>
            <path class="land land-al" d="M260 72l42 20 25 45-4 48 27 50-18 54 8 42-26 51-2 53-29 60-17-30-1-47-26-37 8-46-24-42 13-48-16-37 27-47-4-49z"/>
            <path class="land land-xk" d="M303 91l54-17 45 19 12 46-40 42-51 4 4-48z"/>
            <path class="river" d="M298 108c-17 51 28 79-5 128s14 82-12 136-6 79-12 107"/>
            <g class="marker m1"><circle r="17"/><circle r="5"/></g><g class="marker m2"><circle r="14"/><circle r="4"/></g><g class="marker m3"><circle r="20"/><circle r="6"/></g><g class="marker m4"><circle r="12"/><circle r="4"/></g><g class="marker m5"><circle r="15"/><circle r="5"/></g>
            <text x="348" y="130">KOSOVË</text><text x="277" y="291" transform="rotate(73 277 291)">SHQIPËRI</text>
          </svg>
          <div class="preview-card"><span class="preview-icon">✳</span><span><small>Zonë e mbrojtur</small><strong>Peizazh i dokumentuar</strong></span><b>↗</b></div>
          <div class="preview-bottom"><span><i></i> 485+ pika dhe zona</span><strong>Hap hartën →</strong></div>
        </a>
      </div>
    </section>

    <nav class="topic-strip" aria-label="Seksionet e atlasit"><a href="#statistikat">Statistikat</a><i>✦</i><a href="#zonat">Zonat e mbrojtura</a><i>✦</i><a href="#llojet">Flora & fauna</a><i>✦</i><a href="#sensoret">Sensorët</a><i>✦</i><a href="#shenimet">Shënimet</a></nav>

    <section class="project-stats" id="statistikat">
      <div class="stats-heading"><p class="chapter-number">Projekti në shifra</p><h2>Një atlas që rritet<br />me çdo të dhënë.</h2><p>Një pamje e përmbledhur e materialeve që mund të eksplorohen sot në hartën e Trashëgimisë Natyrore.</p><a href={`${base}dashboard/`}>Hap panelin e plotë të raporteve →</a></div>
      <div class="stats-grid">
        <article><span>01</span><strong>{areaTotal}</strong><h3>Zona natyrore</h3><p>Parqe kombëtare, rezervate dhe zona të mbrojtura me kufij të hapur.</p></article>
        <article><span>02</span><strong>{observationTotal}</strong><h3>Vëzhgime të llojeve</h3><p>{flora.length} regjistrime flore dhe {fauna.length} regjistrime faune nga GBIF.</p></article>
        <article><span>03</span><strong>2</strong><h3>Vende</h3><p>Shqipëria dhe Kosova, të lexuara si një peizazh natyror i ndërlidhur.</p></article>
        <article><span>04</span><strong>{publishedNotes.length}</strong><h3>Shënime publike</h3><p>Ndikime dhe shqetësime të dokumentuara, secila me burimin përkatës.</p></article>
      </div>
    </section>

    <section class="data-section areas-section" id="zonat">
      <div class="data-intro"><p class="chapter-number">01 · Zonat</p><h2>Kufijtë e natyrës,<br /><em>të hapur për të gjithë.</em></h2><p>{areaTotal} parqe, rezervate dhe zona të mbrojtura nga OpenStreetMap/Overpass. Çdo kufi ruan lidhjen me objektin burimor dhe kategorinë e mbrojtjes.</p><a class="data-link" href={`${base}map/`}>Eksploro të gjitha zonat <span>→</span></a></div>
      <div class="area-browser"><div class="browser-head"><span>Vende të zgjedhura</span><b>{areaTotal} zona</b></div>{areaHighlights.map((area, index) => <a class="area-row" href={`${base}map/`}><span>{String(index + 1).padStart(2, '0')}</span><div><strong>{area.properties.name}</strong><small>{area.properties.location} · {area.properties.categoryLabel}</small></div><i>↗</i></a>)}<div class="source-line"><span class="live-dot"></span><span>Burim i hapur</span><a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noreferrer">OpenStreetMap · ODbL ↗</a></div></div>
    </section>

    <section class="data-section species-section" id="llojet">
      <div class="section-heading"><div><p class="chapter-number">02 · Biodiversiteti</p><h2>Flora dhe fauna,<br />vëzhgim pas vëzhgimi.</h2></div><div class="section-summary"><strong>{observationTotal} regjistrime</strong><p>Pikat vijnë nga GBIF dhe tregojnë një vëzhgim të dokumentuar, jo gjithë habitatin e një lloji.</p><a class="data-link" href="https://www.gbif.org/" target="_blank" rel="noreferrer">Shiko burimin GBIF ↗</a></div></div>
      <div class="species-grid">{speciesHighlights.map((item) => <a class="species-card" href={item.properties.sources[0].url} target="_blank" rel="noreferrer"><span class="species-image"><img src={item.properties.image?.url} alt={item.properties.image?.alt || item.properties.name} loading="lazy" /><small>{item.properties.category === 'flora' ? 'Flora' : 'Fauna'}</small></span><span class="species-copy"><i>{item.properties.location}</i><strong>{item.properties.name}</strong><small>{item.properties.extra?.Data || 'Datë e panjohur'} · {item.properties.image?.license}</small></span></a>)}</div>
    </section>

    <section class="data-section sensors-section" id="sensoret">
      <div class="sensor-copy"><p class="chapter-number">03 · Sensorët e hapur</p><h2>Çfarë po matet<br /><em>tani?</em></h2><p>Lexime të drejtpërdrejta nga pajisje komunitare të Sensor.Community. Në hartë kërkojmë stacionin aktiv më të afërt për çdo zonë.</p><div class="sensor-legend"><span><i class="good"></i> Matje e drejtpërdrejtë</span><span><i></i> Përditësim çdo 5 minuta</span></div><a class="data-link light-link" href="https://maps.sensor.community/" target="_blank" rel="noreferrer">Hap rrjetin e sensorëve ↗</a></div>
      <div class="sensor-console"><div class="console-head"><span><i></i> SENSOR.COMMUNITY · LIVE</span><span id="sensor-time">Duke u lidhur…</span></div><div id="sensor-readings" class="live-readings" aria-live="polite"><div class="reading-skeleton"></div><div class="reading-skeleton"></div><div class="reading-skeleton"></div></div><p id="sensor-place" class="console-status">Duke kërkuar sensorë publikë pranë Tiranës…</p><p class="console-caveat">Matjet janë orientuese dhe nuk zëvendësojnë monitorimin zyrtar.</p></div>
    </section>

    <section class="data-section notes-section" id="shenimet">
      <div class="notes-demo" aria-hidden="true"><div class="demo-map-lines"></div><article class="sticky-demo yellow"><small>Shqetësim për verifikim</small><p>Shëno një ndryshim, një vëzhgim apo një pyetje direkt në hartë.</p></article><article class="sticky-demo green"><small>Përmirësim i dokumentuar</small><p>Ruaje lokalisht dhe eksportoje si GeoJSON kur të jesh gati.</p></article><span class="demo-pin">+</span></div>
      <div class="notes-copy"><p class="chapter-number">04 · Shënimet e tua</p><h2>Shto atë që sheh në terren.</h2><p>Vendos shënime personale mbi hartë, kategorizoji sipas gjendjes dhe eksporto një skedar GeoJSON. Shënimet ruhen vetëm në shfletuesin tënd derisa të zgjedhësh t’i ndash.</p><ul><li><span>01</span>Kliko vendin në hartë</li><li><span>02</span>Shto tekstin dhe kategorinë</li><li><span>03</span>Ruaj ose eksporto GeoJSON</li></ul><a class="landing-button note-button" href={`${base}map/?notes=1`}>Shto një shënim <span>＋</span></a></div>
    </section>

    <section class="method-strip"><p>Të dhëna të hapura, burime të gjurmueshme.</p><div><span><strong>{areaTotal}</strong> zona OSM</span><span><strong>{flora.length}</strong> vëzhgime flore</span><span><strong>{fauna.length}</strong> vëzhgime faune</span><span><strong>LIVE</strong> sensorë komunitarë</span></div><a href={`${base}contribute/`}>Metodologjia dhe kontributi →</a>
    </section>

    <section class="landing-cta"><div><p class="eyebrow">Fillo të eksplorosh</p><h2>Çfarë natyre do të zbulosh sot?</h2><a class="landing-button light" href={`${base}map/`}>Hap hartën interaktive <span>→</span></a></div><span class="cta-mark" aria-hidden="true">✳</span></section>
  </main>
  <footer class="landing-footer"><a class="footer-brand" href={base}><span>✳</span> Trashëgimia Natyrore</a><p>Një projekt i hapur për natyrën e Shqipërisë dhe Kosovës.</p><div><a href={`${base}map/`}>Harta</a><a href={`${base}dashboard/`}>Raportet</a><a href={`${base}contribute/`}>Kontribuo</a></div></footer>
</BaseLayout>

<script>
  const readings = document.querySelector<HTMLElement>('#sensor-readings');
  const sensorTime = document.querySelector<HTMLElement>('#sensor-time');
  const sensorPlace = document.querySelector<HTMLElement>('#sensor-place');
  const labels: Record<string, [string, string]> = { P1: ['PM10', 'µg/m³'], P2: ['PM2.5', 'µg/m³'], temperature: ['Temperatura', '°C'], humidity: ['Lagështia', '%'], pressure_at_sealevel: ['Presioni', 'hPa'] };
  fetch('https://data.sensor.community/airrohr/v1/filter/area=41.3275,19.8187,25')
    .then((response) => { if (!response.ok) throw new Error(); return response.json(); })
    .then((data) => {
      const outdoor = (Array.isArray(data) ? data : []).filter((entry) => Number(entry.location?.indoor) !== 1);
      const latest = outdoor.sort((a, b) => String(b.timestamp).localeCompare(String(a.timestamp)))[0];
      if (!latest) throw new Error();
      const values = latest.sensordatavalues.filter((item) => labels[item.value_type] && Number.isFinite(Number(item.value))).slice(0, 4);
      if (!values.length) throw new Error();
      readings?.replaceChildren(...values.map((item) => { const card=document.createElement('div'); card.className='live-reading'; const [label,unit]=labels[item.value_type]; card.innerHTML=`<span>${label}</span><strong>${Number(item.value).toFixed(1)}</strong><small>${unit}</small>`; return card; }));
      const measured = new Date(`${latest.timestamp.replace(' ', 'T')}Z`);
      if (sensorTime) sensorTime.textContent = Number.isNaN(measured.getTime()) ? latest.timestamp : new Intl.DateTimeFormat('sq-AL', { dateStyle:'medium', timeStyle:'short' }).format(measured);
      if (sensorPlace) sensorPlace.textContent = `Stacion publik aktiv · ${Number(latest.location.latitude).toFixed(3)}, ${Number(latest.location.longitude).toFixed(3)}`;
    })
    .catch(() => { if (readings) readings.innerHTML='<p class="sensor-unavailable">Nuk ka matje të drejtpërdrejta pranë Tiranës tani.</p>'; if (sensorTime) sensorTime.textContent='Jashtë linje'; if (sensorPlace) sensorPlace.textContent='Hap një zonë në hartë për të kërkuar sensorin më të afërt.'; });
</script>

<style>
