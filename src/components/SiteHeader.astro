---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
const { page = 'map' } = Astro.props;
// Projects and protests (with their MultiPolygon extents) live in public/data/projects.geojson.
const items = JSON.parse(readFileSync(join(process.cwd(), 'public/data/projects.geojson'), 'utf8')).features.map((feature) => feature.properties);
const groups = [...new Set(items.map((item) => item.group))].map((name) => ({ name, items: items.filter((item) => item.group === name) }));
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---
<header class="app-header">
  <a class="app-brand" href={base} aria-label="Trashëgimia Natyrore">
    <img class="brand-logo" src={`${base}assets/favicon.svg`} alt="" width="42" height="42" />
    <span class="brand-title"><span>TRASHËGIMIA</span><span>NATYRORE</span></span>
  </a>
  <nav id="primary-nav" class="header-actions" aria-label="Veprimet kryesore">
    <a class="header-data" href={base} aria-current={page === 'map' ? 'page' : undefined}>Harta</a>
    <details class="nav-group">
      <summary>Projekte &amp; protesta <span aria-hidden="true">⌄</span></summary>
      <div class="nav-dropdown nav-dropdown-projects">
        {groups.map((group) => (
          <div class="nav-section" role="group" aria-label={group.name}>
            <p class="nav-heading">{group.name}</p>
            {group.items.map((item) => (
              <a href={`${base}${item.href}`} aria-current={page === item.page ? 'page' : undefined}>
                <strong>{item.name}{item.status && <span class="nav-status">{item.status}</span>}</strong>
                <small>{item.tagline}</small>
              </a>
            ))}
          </div>
        ))}
      </div>
    </details>
    <details class="nav-group">
      <summary>Dokumentimi <span aria-hidden="true">⌄</span></summary>
      <div class="nav-dropdown nav-dropdown-right">
        <a href={`${base}docs/baza/`}><strong>Baza e njohurive</strong><small>Natyra, biodiversiteti, kërcënimet dhe ligjet</small></a>
        <a href={`${base}docs/raportimi/`}><strong>Raportimi</strong><small>Kuadrot, treguesit dhe të dhënat</small></a>
        <a href={`${base}docs/aktivizmi/`}><strong>Aktivizmi</strong><small>Nga shqetësimi te veprimi</small></a>
        <a href={`${base}docs/rreth/`}><strong>Rreth nesh</strong><small>Nisma, rrjeti dhe si të bashkohesh</small></a>
      </div>
    </details>
    <slot name="about-actions"><a class="header-data" href={`${base}#rreth-nismes`}>Rreth nismes</a></slot>
  </nav>
  <button class="mobile-menu-toggle" type="button" aria-controls="primary-nav" aria-expanded="false" aria-label="Hap menunë"><span></span><span></span><span></span></button>
</header>
